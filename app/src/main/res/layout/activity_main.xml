<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Japanese → English Live Captions"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Captions the audio playing on your phone (any app or browser) using on-device AI and shows English subtitles on top of other apps."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textStyle="italic" />

        <RadioGroup
            android:id="@+id/modelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioReazon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recommended: Japanese model, fast and accurate (about 170 MB). Shows captions while people are still talking." />

            <RadioButton
                android:id="@+id/radioSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Whisper small (about 375 MB). Slower, handles noisy audio." />

            <RadioButton
                android:id="@+id/radioBase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Whisper base (about 150 MB). Faster than small, less accurate." />
        </RadioGroup>

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. Allow display over other apps" />

        <Button
            android:id="@+id/btnModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Download selected model" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3. START captions" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="STOP captions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tips:\n• When Android asks to share your screen, choose “Entire screen”. The app only listens to audio; it does not record your screen.\n• After START, open your video app or browser. Captions appear a few seconds after each sentence. Drag the box to move it, tap ✕ Stop to end.\n• Some apps (Netflix, some streaming apps) block audio capture and will give no captions."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
